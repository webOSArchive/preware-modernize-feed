Source: { "Type":"Patch", "Feed":"WOSA Modernize", "Category":"Browser", "LastUpdated":"1782744397", "Title":"Make Atlas the default browser", "FullDescription":"Redirects the stock web browser to Atlas (org.webosports.app.atlas), the modern WebKit browser for webOS, and hides the stock browser icon from the Launcher. Patches com.palm.app.browser so every launch -- tapping links, cross-app launches, and type-to-search -- opens in Atlas instead of the stock browser, and sets the stock browser to hidden so only Atlas shows in the Launcher. Self-contained (no AUSMT): the original index.html and appinfo.json are backed up and restored on removal. If Atlas is not installed the redirect page offers a Load Stock Browser fallback (works even with the icon hidden). Restart Luna (or relaunch the browser) to apply.", "MinWebOSVersion":"3.0.5", "MaxWebOSVersion":"3.9.9", "PostInstallFlags":"RestartLuna", "PostUpdateFlags":"RestartLuna", "PostRemoveFlags":"RestartLuna" }

