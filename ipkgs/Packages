Source: { "LastUpdated":"1782938134", "Type":"Application", "Feed":"WOSA Modernize", "Category":"Modernize", "Title":"Browser TLS 1.3 (TouchPad)", "FullDescription":"<b>webOS 3.0.5 only -- do NOT install on a webOS 2.x phone (Pre3 / Pre2 / Veer), and not needed on webOS 3.1+ (TLS 1.2/1.3 is baked in natively there).</b> This build patches TouchPad (webOS 3.0.5) binaries and will break a phone. Phone builds of this package are made per device and are packaged separately.<br><br>Adds a process-private OpenSSL 1.1.1w + curl(zlib) under /usr/lib/ssl11 and points the stock BrowserServer at it via RPATH, so the 2011 browser can reach modern TLS 1.2/1.3 sites. Requires a current /etc/ssl/certs/ca-certificates.crt (Mozilla ca-certificates).", "License":"OpenSSL/curl", "MinWebOSVersion":"3.0.5", "MaxWebOSVersion":"3.0.9", "Icon":"http://stacks.webosarchive.org/feeds/modernize/ipkgs/assets/icons/openssl_icon.png" }

Package: org.webosinternals.downloadmgr-tls13
